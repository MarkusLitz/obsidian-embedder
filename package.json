{
    "name": "mlitz-drive-embedder",
    "version": "2.0.0",
    "description": "Upload private files to Google Drive, render authenticated media & PDF.js embeds, and use Google Smart Chips in Obsidian",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "google-drive",
        "embedder",
        "file-upload",
        "smart-chips",
        "audio",
        "video",
        "pdf"
    ],
    "author": "Markus Litz",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "5.29.0",
        "@typescript-eslint/parser": "5.29.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "tslib": "2.4.0",
        "typescript": "4.7.4"
    },
    "dependencies": {}
}
